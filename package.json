    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "clsx": "2.1.1",
    "lucide-react": "1.64.0",
    "next": "16.4.3",
    "openai": "^7.45.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@10.32.1",
